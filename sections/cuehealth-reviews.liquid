{{ 'cuehealth-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cuehealth-reviews.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign reviews = product.metafields.custom.cuehealth_reviews.value
  assign review_count = 0
  assign rated_count = 0
  assign rating_sum = 0
  assign cards = ''
  assign photos = ''
-%}
{%- comment -%}Batches keep each Liquid for loop below 50 iterations, including lists over 50 entries.{%- endcomment -%}
{%- for batch in (0..20) -%}
  {%- assign offset = batch | times: 50 -%}
  {%- assign batch_reviews = reviews | slice: offset, 50 -%}
  {%- for review in batch_reviews -%}
    {%- if review.product_reference.value.id == product.id and review.reviewer_name.value != blank and review.review_text.value != blank -%}
      {%- liquid
        assign review_count = review_count | plus: 1
        assign rating = review.rating.value | default: 0 | plus: 0
        if rating >= 1 and rating <= 5
          assign rated_count = rated_count | plus: 1
          assign rating_sum = rating_sum | plus: rating
        endif
        assign photo = review.customer_image.value
        assign photo_alt = review.image_alt_text.value
        if photo_alt == blank
          assign photo_alt = 'Customer review for ' | append: product.title
        endif
      -%}
      {%- capture card -%}
        <article class="cue-review-card" id="CueReview-{{ section.id }}-{{ review_count }}" tabindex="-1" data-cue-card>
          {%- if photo != blank -%}
            <a class="cue-review-card__photo" href="#CueReview-{{ section.id }}-{{ review_count }}" data-cue-open aria-label="Read review by {{ review.reviewer_name.value | escape }}">
              {{ photo | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(min-width: 990px) 33vw, 85vw', loading: 'lazy', alt: photo_alt }}
            </a>
          {%- endif -%}
          <div class="cue-review-card__body">
            {%- if rating >= 1 and rating <= 5 -%}
              <div class="cue-reviews-stars" role="img" aria-label="{{ rating }} out of 5 stars"><span aria-hidden="true">{%- for star in (1..5) -%}{% if star <= rating %}★{% else %}☆{% endif %}{%- endfor -%}</span></div>
            {%- endif -%}
            <h3 class="cue-review-card__name">{{ review.reviewer_name.value | escape }}</h3>
            <p class="cue-review-card__meta">
              {% if review.location.value != blank %}<span>{{ review.location.value | escape }}</span>{% endif %}
              {% if review.review_date.value != blank %}<time datetime="{{ review.review_date.value | date: '%Y-%m-%d' }}">{{ review.review_date.value | date: '%d %b %Y' }}</time>{% endif %}
            </p>
            {% case review.verification_status.value %}{% when 'verified_purchase' %}<p class="cue-review-card__badge">Verified purchase</p>{% when 'verified_customer' %}<p class="cue-review-card__badge">Verified customer</p>{% endcase %}
            <blockquote class="cue-review-card__text">{{ review.review_text.value | escape | newline_to_br }}</blockquote>
          </div>
        </article>
      {%- endcapture -%}
      {%- assign cards = cards | append: card -%}
      {%- if photo != blank -%}
        {%- capture thumbnail -%}
          <a class="cue-reviews-photo" href="#CueReview-{{ section.id }}-{{ review_count }}" data-cue-open aria-label="Read review by {{ review.reviewer_name.value | escape }}">
            {{ photo | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '120px', loading: 'lazy', alt: photo_alt }}
          </a>
        {%- endcapture -%}
        {%- if review.featured.value == true -%}{%- assign photos = thumbnail | append: photos -%}{%- else -%}{%- assign photos = photos | append: thumbnail -%}{%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign demo_mode = false -%}
{%- if request.design_mode and section.settings.show_demo and review_count == 0 -%}
  {%- assign demo_mode = true -%}
  {%- assign demo_alt = 'SAMPLE/DEMO product photo for ' | append: product.title -%}
  {%- for demo_index in (1..3) -%}
    {%- capture demo_card -%}
      <article class="cue-review-card" id="CueReview-{{ section.id }}-demo-{{ demo_index }}" tabindex="-1" data-cue-card>
        {% if product.featured_image != blank %}
          <a class="cue-review-card__photo" href="#CueReview-{{ section.id }}-demo-{{ demo_index }}" data-cue-open aria-label="Open SAMPLE/DEMO review {{ demo_index }}">
            {{ product.featured_image | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: '(min-width: 990px) 33vw, 85vw', loading: 'lazy', alt: demo_alt }}
          </a>
        {% endif %}
        <div class="cue-review-card__body">
          <p class="cue-review-card__badge"><strong>SAMPLE/DEMO — not a customer review</strong></p>
          <div class="cue-reviews-stars" role="img" aria-label="Example rating: 5 out of 5 stars"><span aria-hidden="true">★★★★★</span></div>
          <h3 class="cue-review-card__name">Demo customer {{ demo_index }}</h3>
          <blockquote class="cue-review-card__text">{% case demo_index %}{% when 1 %}Sample layout: genuine customer feedback about {{ product.title | escape }} will appear here.{% when 2 %}Sample layout: a longer customer story can be displayed here, preserving the customer's original meaning. This text demonstrates how multiple lines fit inside the card.{% when 3 %}Sample layout: Hindi or Hinglish feedback can be translated here after approval. The image above is a product photo, not a customer photo.{% endcase %}</blockquote>
        </div>
      </article>
    {%- endcapture -%}
    {%- assign cards = cards | append: demo_card -%}
    {% if product.featured_image != blank %}
      {%- capture demo_photo -%}
        <a class="cue-reviews-photo" href="#CueReview-{{ section.id }}-demo-{{ demo_index }}" data-cue-open aria-label="Open SAMPLE/DEMO review {{ demo_index }}">
          {{ product.featured_image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '120px', loading: 'lazy', alt: demo_alt }}
        </a>
      {%- endcapture -%}
      {%- assign photos = photos | append: demo_photo -%}
    {% endif %}
  {%- endfor -%}
{%- endif -%}
{%- if product != blank -%}
<cuehealth-reviews class="cue-reviews" style="--cue-reviews-columns: {{ section.settings.desktop_columns }}; --cue-reviews-mobile-width: {% if section.settings.mobile_columns == '2' %}46%{% else %}85%{% endif %}; --cue-reviews-top: {{ section.settings.padding_top }}px; --cue-reviews-bottom: {{ section.settings.padding_bottom }}px" data-page-size="{{ section.settings.reviews_per_page }}" data-load-more="{{ section.settings.enable_load_more }}" data-lightbox="{{ section.settings.enable_lightbox }}">
  <div class="cue-reviews-inner page-width">
    <header class="cue-reviews-header">
      <p class="cue-reviews-eyebrow">Customer experiences</p>
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if review_count > 0 %}<p class="cue-reviews-disclosure">Genuine customer feedback, shared with permission and published by Cuehealth on customers’ behalf.</p>{% endif %}
      {% if section.settings.show_summary and review_count > 0 %}
        <div class="cue-reviews-summary">
          {% if rated_count > 0 %}{% assign average = rating_sum | times: 1.0 | divided_by: rated_count | round: 1 %}<strong>{{ average }}/5</strong><span>Based on {{ rated_count }} customer rating{% if rated_count != 1 %}s{% endif %}</span>{% endif %}
          <span>{{ review_count }} customer review{% if review_count != 1 %}s{% endif %}</span>
        </div>
      {% endif %}
      {% if demo_mode %}<p class="cue-reviews-disclosure"><strong>SAMPLE/DEMO preview only.</strong> These are layout placeholders, not customer testimonials. Images are product photos. Demos are hidden on the public storefront and excluded from customer counts and ratings.</p>{% endif %}
      {%- if section.settings.submit_url != blank -%}
        <button type="button" class="cue-reviews-write__toggle" data-cue-write-toggle>Write a review</button>
      {%- endif -%}
    </header>
    {%- if section.settings.submit_url != blank -%}
      <form class="cue-reviews-write__form" data-cue-write-form hidden data-submit-url="{{ section.settings.submit_url }}" data-product-id="{{ product.id }}">
        <div class="cue-reviews-write__row">
          <div class="cue-reviews-write__field">
            <label for="CueReviewName-{{ section.id }}">Your name</label>
            <input id="CueReviewName-{{ section.id }}" name="name" type="text" required maxlength="80" autocomplete="name">
          </div>
          <div class="cue-reviews-write__field">
            <label for="CueReviewLocation-{{ section.id }}">City (optional)</label>
            <input id="CueReviewLocation-{{ section.id }}" name="location" type="text" maxlength="60">
          </div>
        </div>
        <div class="cue-reviews-write__field">
          <label for="CueReviewRating-{{ section.id }}">Rating</label>
          <select id="CueReviewRating-{{ section.id }}" name="rating" required>
            <option value="">Select</option>
            <option value="5">5 — Excellent</option>
            <option value="4">4 — Good</option>
            <option value="3">3 — Okay</option>
            <option value="2">2 — Poor</option>
            <option value="1">1 — Very poor</option>
          </select>
        </div>
        <div class="cue-reviews-write__field">
          <label for="CueReviewText-{{ section.id }}">Your review</label>
          <textarea id="CueReviewText-{{ section.id }}" name="reviewText" rows="4" required maxlength="1000"></textarea>
        </div>
        <div class="cue-reviews-write__field">
          <label for="CueReviewPhoto-{{ section.id }}">Add a photo (optional)</label>
          <input id="CueReviewPhoto-{{ section.id }}" name="photo" type="file" accept="image/*">
        </div>
        <label class="cue-reviews-write__consent">
          <input type="checkbox" required>
          <span>This is my honest experience, and I agree Cuehealth may publish it after review.</span>
        </label>
        <button type="submit" class="cue-reviews-write__submit">Submit review</button>
        <p class="cue-reviews-write__status" role="status" aria-live="polite" data-cue-write-status></p>
      </form>
    {%- endif -%}
    {% if section.settings.show_gallery and photos != blank %}<nav class="cue-reviews-gallery" aria-label="Customer photo reviews">{{ photos }}</nav>{% endif %}
    {% if review_count > 0 or demo_mode %}
      <div class="cue-reviews-grid" data-cue-grid>{{ cards }}</div>
      <button type="button" class="cue-reviews-more" data-cue-more hidden>Load more reviews</button>
      <p class="cue-reviews-status" role="status" aria-live="polite" data-cue-status></p>
      {% if section.settings.enable_lightbox %}
        <dialog class="cue-reviews-dialog" aria-label="Customer review" data-cue-dialog>
          <button class="cue-reviews-close" type="button" data-cue-close aria-label="Close customer review">✕</button>
          <div data-cue-dialog-content></div>
        </dialog>
      {% endif %}
    {% else %}
      <div class="cue-reviews-empty">
        <p>No customer reviews for {{ product.title | escape }} yet.</p>
        <a class="cue-reviews-empty__cta" href="https://wa.me/917455918832?text={{ 'Hi! I have used this product and would like to share my experience.' | url_encode }}" target="_blank" rel="noopener">Share your experience on WhatsApp</a>
        {% if request.design_mode %}<p class="cue-reviews-empty__hint">Add genuine review entries and link them in this product’s Cuehealth reviews metafield.</p>{% endif %}
      </div>
    {% endif %}
  </div>
</cuehealth-reviews>
{%- endif -%}
{% schema %}
{
  "name": "Cuehealth Reviews",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Experiences from our community"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show rating summary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_gallery",
      "label": "Show photo gallery",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_lightbox",
      "label": "Enable review dialog",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "Enable load more",
      "default": true
    },
    {
      "type": "range",
      "id": "reviews_per_page",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 8,
      "label": "Reviews per load"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile cards visible",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_demo",
      "label": "Show demo cards in editor",
      "default": true,
      "info": "Only when no genuine reviews exist. Product photos and sample text are never shown publicly."
    },
    {
      "type": "url",
      "id": "submit_url",
      "label": "Review submission URL",
      "info": "The deployed Apps Script /exec URL from google-apps-script/review-api.gs. The 'Write a review' button is hidden until this is set."
    }
  ],
  "presets": [
    {
      "name": "Cuehealth Reviews"
    }
  ]
}
{% endschema %}
