// ═══════════════════════════════════════════
//  NAVIGATION
// ═══════════════════════════════════════════

function showView(id) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function startQuiz() {
  state.stepIndex = 0;
  state.answers = {};
  showView('viewQuiz');
  renderStep();
}

function renderStep() {
  const step = questions[state.stepIndex];
  const total = questions.length;

  // update progress
  const progressPct = ((state.stepIndex + 1) / total) * 100;
  document.getElementById('progressFill').style.width = progressPct + '%';
  document.getElementById('progressLabel').textContent =
    step.insight ? 'A moment' : `Question ${countQuestionNumber()} of 8`;

  // back button state
  document.getElementById('quizBack').disabled = state.stepIndex === 0;

  const content = document.getElementById('quizContent');

  if (step.insight) {
    const ins = insights[step.id];
    content.innerHTML = `
      <div class="insight">
        <div class="insight-mark">${ins.mark}</div>
        <p class="insight-body">${ins.body}</p>
        <p class="insight-attrib">${ins.attrib}</p>
        <button class="insight-cta" onclick="nextStep()">${ins.cta}</button>
      </div>
    `;
  } else {
    const optionsHtml = step.options.map((opt, i) => `
      <button class="option" onclick="selectOption('${step.id}', ${JSON.stringify(opt.value).replace(/"/g,'&quot;')})">
        <span class="option-marker"></span>
        <span>${opt.label}</span>
      </button>
    `).join('');

    content.innerHTML = `
      <div class="question">
        <h2 class="question-title">${step.title}</h2>
        <p class="question-hint">${step.hint}</p>
        <div class="options">${optionsHtml}</div>
      </div>
    `;
  }
}

function countQuestionNumber() {
  // count only non-insight questions up to and including current
  let n = 0;
  for (let i = 0; i <= state.stepIndex; i++) {
    if (!questions[i].insight) n++;
  }
  return n;
}

function selectOption(qid, value) {
  state.answers[qid] = value;
  setTimeout(nextStep, 200); // slight delay for feel
}

function nextStep() {
  state.stepIndex++;
  if (state.stepIndex >= questions.length) {
    showResult();
  } else {
    renderStep();
  }
}

function goBack() {
  if (state.stepIndex > 0) {
    state.stepIndex--;
    renderStep();
  }
}

