<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light">
<title>Cuehealth Cycle Check — Discover Your Period Type</title>
<meta name="description" content="2-minute Cycle Check. 8 questions. Discover your Period Type and what your body needs. Made by Cuehealth — Ayurvedic period care for real Indian women.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,ital,wght@9..144,0,400;9..144,0,500;9..144,0,600;9..144,0,700;9..144,1,400;9..144,1,500;9..144,1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --ivory: #FBF6F0;
  --ivory-deep: #F5EDE2;
  --pink-soft: #FCE7EC;
  --pink-blush: #F2C8D0;
  --rose: #E8B4BC;
  --maroon: #7A1E3C;
  --maroon-deep: #5A1329;
  --gold: #B8935E;
  --text: #2A1518;
  --text-muted: #6B5560;
  --border: #E8D6D9;
  --white: #FFFFFF;
  --safe-top: env(safe-area-inset-top, 0px);
  --safe-bottom: env(safe-area-inset-bottom, 0px);
}
:root { box-sizing: border-box; padding-top: var(--safe-top); padding-bottom: var(--safe-bottom); }
*, *::before, *::after { box-sizing: inherit; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  color: var(--text);
  background: var(--ivory);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
img, svg { max-width: 100%; display: block; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
a { color: var(--maroon); }

/* ─── ANNOUNCE ─── */
.announce {
  background: var(--maroon-deep);
  color: var(--ivory);
  font-size: 12.5px;
  text-align: center;
  padding: 8px 16px;
  font-weight: 500;
  letter-spacing: 0.02em;
}
.announce span { margin: 0 8px; opacity: 0.9; }
.announce span::before { content: '✦ '; color: var(--gold); }

/* ─── HEADER ─── */
header {
  padding: 18px 24px;
  background: rgba(251, 246, 240, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: var(--safe-top);
  z-index: 30;
}
.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.brand {
  font-family: 'Fraunces', serif;
  font-weight: 600;
  font-size: 22px;
  color: var(--maroon);
  letter-spacing: -0.01em;
}
.brand small {
  font-family: 'Inter', sans-serif;
  font-size: 10px;
  color: var(--text-muted);
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  display: block;
  line-height: 1;
  margin-top: 2px;
}
.header-phone {
  font-size: 13px;
  color: var(--text-muted);
  text-decoration: none;
  font-weight: 500;
}
.header-phone strong { color: var(--maroon); font-weight: 600; }
@media (max-width: 520px) { .header-phone { display: none; } }

/* ─── APP VIEWS ─── */
.view { display: none; }
.view.active { display: block; }

/* ─── INTRO (HERO + QUIZ INVITE) ─── */
.intro {
  padding: 48px 24px 72px;
  max-width: 1200px;
  margin: 0 auto;
}
.intro-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  align-items: center;
}
@media (min-width: 900px) {
  .intro-grid { grid-template-columns: 1.15fr 1fr; gap: 64px; }
  .intro { padding: 72px 24px 96px; }
}

.hero-eyebrow {
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 15px;
  color: var(--maroon);
  margin: 0 0 18px;
  font-weight: 500;
}
.hero-eyebrow::before {
  content: '';
  display: inline-block;
  width: 32px;
  height: 1px;
  background: var(--gold);
  vertical-align: middle;
  margin-right: 12px;
}
h1.hero-title {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: clamp(32px, 5.5vw, 52px);
  line-height: 1.08;
  letter-spacing: -0.02em;
  margin: 0 0 20px;
}
h1.hero-title em {
  font-style: italic;
  font-weight: 400;
  color: var(--maroon);
}
.hero-lede {
  font-size: 17px;
  line-height: 1.6;
  color: var(--text-muted);
  max-width: 520px;
  margin: 0 0 28px;
}

.what-youll-get {
  margin: 0 0 32px;
  padding: 24px 22px;
  background: var(--white);
  border: 1px solid var(--border);
  border-left: 3px solid var(--maroon);
  border-radius: 2px;
}
.what-youll-get h4 {
  font-family: 'Fraunces', serif;
  font-size: 14px;
  font-style: italic;
  color: var(--maroon);
  margin: 0 0 12px;
  font-weight: 500;
}
.what-youll-get ul {
  list-style: none;
  padding: 0;
  margin: 0;
}
.what-youll-get li {
  font-size: 14.5px;
  color: var(--text);
  padding: 6px 0 6px 22px;
  position: relative;
  line-height: 1.5;
}
.what-youll-get li::before {
  content: '✦';
  position: absolute;
  left: 0;
  top: 6px;
  color: var(--gold);
  font-size: 11px;
}

.cta-primary {
  padding: 18px 28px;
  font-size: 16px;
  font-weight: 600;
  border-radius: 6px;
  background: var(--maroon);
  color: var(--ivory);
  transition: transform 0.15s ease, background 0.2s;
  box-shadow: 0 4px 14px rgba(122, 30, 60, 0.22);
  min-width: 260px;
}
.cta-primary:hover { background: var(--maroon-deep); box-shadow: 0 6px 18px rgba(122, 30, 60, 0.3); }
.cta-primary:active { transform: translateY(1px); }

.time-note {
  margin: 14px 0 0;
  font-size: 13px;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  gap: 8px;
}
.time-note::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gold);
}

.hero-visual {
  position: relative;
  padding: 20px;
  text-align: center;
}
.hero-visual-bg {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 45%, var(--pink-soft) 0%, var(--ivory-deep) 55%, transparent 78%);
  z-index: 0;
}
.hero-visual svg {
  position: relative;
  z-index: 1;
  max-width: 380px;
  width: 100%;
  margin: 0 auto;
}
.hero-visual-caption {
  position: relative;
  z-index: 2;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 13.5px;
  color: var(--maroon);
  margin: 16px 0 0;
  line-height: 1.5;
}

/* ─── SECONDARY INTRO SECTIONS ─── */
.intro-belt {
  background: var(--ivory-deep);
  padding: 40px 24px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.belt-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: center;
}
@media (min-width: 800px) { .belt-inner { grid-template-columns: 2fr 1fr; gap: 48px; } }
.belt-text {
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 17px;
  line-height: 1.55;
  color: var(--text);
  margin: 0;
}
.belt-text strong { color: var(--maroon); font-style: normal; font-weight: 600; }
.belt-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: flex-start;
}
@media (min-width: 800px) { .belt-badges { justify-content: flex-end; } }
.belt-badge {
  font-size: 11px;
  padding: 6px 12px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 20px;
  color: var(--maroon);
  font-weight: 600;
  letter-spacing: 0.04em;
}

/* ─── QUIZ ─── */
.quiz-shell {
  min-height: 80vh;
  padding: 24px 20px 60px;
  max-width: 640px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
}

.quiz-topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 4px;
  margin-bottom: 24px;
}
.quiz-back {
  font-size: 13px;
  color: var(--text-muted);
  font-weight: 500;
  padding: 6px 10px;
  border-radius: 4px;
  transition: color 0.15s;
}
.quiz-back:hover { color: var(--maroon); }
.quiz-back:disabled { opacity: 0.3; cursor: default; }
.quiz-progress-label {
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 13px;
  color: var(--text-muted);
}

.quiz-progress {
  height: 3px;
  background: var(--border);
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 40px;
}
.quiz-progress-fill {
  height: 100%;
  background: var(--maroon);
  width: 0%;
  transition: width 0.4s ease;
  border-radius: 2px;
}

.question {
  animation: fadeIn 0.4s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}

.question-title {
  font-family: 'Fraunces', serif;
  font-size: clamp(24px, 4vw, 32px);
  font-weight: 500;
  line-height: 1.2;
  color: var(--text);
  margin: 0 0 12px;
  letter-spacing: -0.01em;
}
.question-title em { font-style: italic; color: var(--maroon); font-weight: 400; }
.question-hint {
  font-size: 14px;
  color: var(--text-muted);
  margin: 0 0 32px;
  font-family: 'Fraunces', serif;
  font-style: italic;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.option {
  padding: 18px 20px;
  border: 1.5px solid var(--border);
  background: var(--white);
  border-radius: 8px;
  font-size: 15px;
  color: var(--text);
  text-align: left;
  cursor: pointer;
  transition: all 0.15s ease;
  font-weight: 500;
  line-height: 1.4;
  display: flex;
  align-items: center;
  gap: 14px;
}
.option:hover {
  border-color: var(--maroon);
  background: var(--pink-soft);
  transform: translateY(-1px);
}
.option:active { transform: translateY(0); }
.option-marker {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1.5px solid var(--border);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;
}
.option:hover .option-marker {
  border-color: var(--maroon);
  background: var(--maroon);
  color: var(--white);
}
.option:hover .option-marker::after {
  content: '→';
  font-size: 13px;
  font-weight: 700;
}

/* ─── INSIGHT INTERSTITIAL ─── */
.insight {
  animation: fadeIn 0.5s ease;
  text-align: center;
  padding: 40px 0;
}
.insight-mark {
  display: inline-block;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 14px;
  color: var(--gold);
  margin: 0 0 20px;
  letter-spacing: 0.05em;
}
.insight-mark::before, .insight-mark::after {
  content: '';
  display: inline-block;
  width: 24px;
  height: 1px;
  background: var(--gold);
  vertical-align: middle;
  margin: 0 12px;
}
.insight-body {
  font-family: 'Fraunces', serif;
  font-size: clamp(22px, 3.5vw, 28px);
  font-weight: 400;
  line-height: 1.35;
  color: var(--text);
  margin: 0 auto 36px;
  max-width: 560px;
  letter-spacing: -0.01em;
}
.insight-body strong { color: var(--maroon); font-weight: 600; }
.insight-attrib {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0 0 40px;
  font-family: 'Fraunces', serif;
  font-style: italic;
}
.insight-cta {
  padding: 14px 32px;
  background: var(--maroon);
  color: var(--ivory);
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.02em;
}
.insight-cta:hover { background: var(--maroon-deep); }

/* ─── RESULT ─── */
.result-shell {
  max-width: 860px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

.result-header {
  text-align: center;
  padding: 40px 0 32px;
  animation: fadeIn 0.6s ease;
}
.result-eyebrow {
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 14px;
  color: var(--maroon);
  margin: 0 0 8px;
  letter-spacing: 0.03em;
}
.result-you-are {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  color: var(--text-muted);
  margin: 0 0 6px;
  font-style: italic;
}
.result-type {
  font-family: 'Fraunces', serif;
  font-size: clamp(40px, 7vw, 68px);
  font-weight: 600;
  color: var(--maroon-deep);
  margin: 0 0 20px;
  line-height: 1.05;
  letter-spacing: -0.02em;
}
.result-type::after {
  content: '';
  display: block;
  width: 60px;
  height: 2px;
  background: var(--gold);
  margin: 20px auto 0;
}
.result-summary {
  font-family: 'Fraunces', serif;
  font-size: 19px;
  line-height: 1.55;
  color: var(--text);
  max-width: 640px;
  margin: 0 auto;
  font-style: italic;
}

.result-block {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 36px 28px;
  margin-top: 32px;
  border-radius: 2px;
  animation: fadeIn 0.6s ease 0.2s both;
}
@media (min-width: 700px) { .result-block { padding: 44px 44px; } }
.result-block h3 {
  font-family: 'Fraunces', serif;
  font-size: 22px;
  color: var(--maroon-deep);
  margin: 0 0 8px;
  font-weight: 600;
  letter-spacing: -0.01em;
}
.result-block h3 + p {
  font-family: 'Fraunces', serif;
  font-style: italic;
  color: var(--text-muted);
  font-size: 14px;
  margin: 0 0 24px;
}

.body-map {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
@media (min-width: 600px) { .body-map { grid-template-columns: 1fr 1fr; gap: 20px; } }
.body-map-item {
  padding: 16px 18px;
  background: var(--ivory);
  border-radius: 4px;
  border-left: 2px solid var(--gold);
}
.body-map-item b {
  font-family: 'Fraunces', serif;
  font-size: 15px;
  color: var(--maroon);
  display: block;
  margin-bottom: 4px;
  font-weight: 600;
}
.body-map-item span {
  font-size: 13.5px;
  color: var(--text);
  line-height: 1.5;
}

.ingredients-for-you {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 20px;
}
@media (min-width: 600px) { .ingredients-for-you { grid-template-columns: 1fr 1fr; } }
.ingredient-tile {
  padding: 18px 20px;
  background: var(--ivory);
  border-radius: 4px;
  border-top: 2px solid var(--maroon);
}
.ingredient-tile b {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-bottom: 4px;
}
.ingredient-tile b span {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 500;
  color: var(--gold);
  margin-left: 8px;
  letter-spacing: 0.05em;
}
.ingredient-tile p {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.5;
}

/* ─── PRODUCT INTRO IN RESULT ─── */
.product-intro {
  background: linear-gradient(135deg, var(--pink-soft) 0%, var(--ivory-deep) 100%);
  padding: 40px 28px;
  border-radius: 4px;
  margin-top: 32px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: center;
  animation: fadeIn 0.6s ease 0.3s both;
}
@media (min-width: 700px) { .product-intro { grid-template-columns: 200px 1fr; padding: 44px 40px; gap: 40px; } }

.product-intro-visual svg {
  max-width: 180px;
  margin: 0 auto;
}

.product-intro-copy .kit-label {
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 13px;
  color: var(--maroon);
  margin: 0 0 6px;
}
.product-intro-copy h3 {
  font-family: 'Fraunces', serif;
  font-size: 26px;
  color: var(--maroon-deep);
  margin: 0 0 10px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.15;
}
.product-intro-copy p {
  font-size: 14.5px;
  color: var(--text);
  line-height: 1.6;
  margin: 0 0 16px;
}
.product-intro-price {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-top: 12px;
}
.product-intro-price b {
  font-family: 'Fraunces', serif;
  font-size: 30px;
  color: var(--maroon-deep);
  font-weight: 600;
  line-height: 1;
}
.product-intro-price s { color: var(--text-muted); font-size: 15px; }
.product-intro-price span {
  background: var(--maroon);
  color: var(--ivory);
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 3px;
  font-weight: 600;
  letter-spacing: 0.05em;
}

/* ─── CTA BOX AT RESULT END ─── */
.result-cta-box {
  margin-top: 40px;
  padding: 40px 28px;
  background: var(--maroon-deep);
  color: var(--ivory);
  border-radius: 6px;
  text-align: center;
  animation: fadeIn 0.6s ease 0.4s both;
}
@media (min-width: 700px) { .result-cta-box { padding: 52px 40px; } }
.result-cta-eyebrow {
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 14px;
  color: var(--rose);
  margin: 0 0 10px;
}
.result-cta-title {
  font-family: 'Fraunces', serif;
  font-size: clamp(24px, 3.5vw, 32px);
  font-weight: 500;
  margin: 0 auto 14px;
  line-height: 1.2;
  max-width: 520px;
  letter-spacing: -0.01em;
}
.result-cta-sub {
  font-size: 14.5px;
  opacity: 0.85;
  max-width: 520px;
  margin: 0 auto 32px;
  line-height: 1.55;
}
.result-cta-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: 380px;
  margin: 0 auto;
}
@media (min-width: 500px) { .result-cta-actions { max-width: 460px; } }

.result-cta-actions .cta-solid {
  padding: 17px 20px;
  background: var(--ivory);
  color: var(--maroon-deep);
  border-radius: 6px;
  font-weight: 700;
  font-size: 15px;
  transition: all 0.15s;
}
.result-cta-actions .cta-solid:hover { background: var(--white); transform: translateY(-1px); }
.cta-desc {
  font-size: 12px;
  opacity: 0.7;
  margin: 4px 0 0;
  font-family: 'Fraunces', serif;
  font-style: italic;
}
.cta-outline {
  padding: 15px 20px;
  background: transparent;
  color: var(--ivory);
  border: 1px solid rgba(251, 246, 240, 0.35);
  border-radius: 6px;
  font-weight: 600;
  font-size: 14px;
  margin-top: 8px;
  transition: all 0.15s;
}
.cta-outline:hover { border-color: var(--ivory); background: rgba(251, 246, 240, 0.05); }

.result-guarantee {
  margin: 24px auto 0;
  font-size: 12.5px;
  color: var(--rose);
  font-family: 'Fraunces', serif;
  font-style: italic;
}

/* ─── FOOTER ─── */
footer {
  background: var(--maroon-deep);
  color: var(--ivory);
  padding: 32px 24px 24px;
  font-size: 12.5px;
  line-height: 1.6;
  margin-top: 40px;
}
.footer-inner {
  max-width: 1160px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 700px) { .footer-inner { grid-template-columns: 2fr 1fr 1fr; } }
.footer-brand {
