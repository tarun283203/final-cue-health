<style>
:root{
  --ma:#7A1E3C;--ma2:#5A1329;
  --iv:#FBF6F0;--iv2:#F5EDE2;
  --bl:#FCE7EC;--ro:#E8B4BC;
  --go:#B8935E;--tx:#2A1518;--mu:#6B5560;--bd:#E8D6D9;--wh:#fff;
  --st:env(safe-area-inset-top,0px);
  --sb:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{-webkit-tap-highlight-color:transparent;scroll-behavior:smooth}
body{
  font-family:'Inter',system-ui,sans-serif;
  font-size:15px;line-height:1.55;
  color:var(--tx);background:var(--iv);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
button{font-family:inherit;cursor:pointer;border:none;background:none;-webkit-appearance:none}
img{max-width:100%;display:block}
a{color:var(--ma);text-decoration:none}
.vw{display:none}.vw.on{display:block}

/* ── HEADER ── */
header{
  position:sticky;top:0;z-index:50;
  background:rgba(251,246,240,.96);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid var(--bd);
  padding:13px 20px;
}
.hdr{max-width:960px;margin:0 auto;display:flex;justify-content:space-between;align-items:center}
.logo{font-family:'Fraunces',serif;font-weight:600;font-size:20px;color:var(--ma);line-height:1}
.logo span{display:block;font-family:'Inter',sans-serif;font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mu);font-weight:500;margin-top:2px}
.hdr-wa{display:flex;align-items:center;gap:5px;font-size:12.5px;color:var(--mu);font-weight:500}
.wa-dot{width:8px;height:8px;background:#25D366;border-radius:50%;flex-shrink:0}
.hdr-wa b{color:var(--ma)}

/* ── HERO — full bleed image + text below ── */
.hero{background:var(--iv);position:relative}

.hero-img-wrap{
  width:100%;
  position:relative;
  overflow:hidden;
  /* Height: show ~65% of viewport on mobile */
  height:62svh;
  max-height:520px;
}
.hero-img-wrap img{
  width:100%;height:100%;
  object-fit:cover;
  object-position:center 15%;
  display:block;
}
/* Gradient fade at bottom of image into page bg */
.hero-img-wrap::after{
  content:'';
  position:absolute;bottom:0;left:0;right:0;
  height:80px;
  background:linear-gradient(to bottom, transparent, var(--iv));
  pointer-events:none;
}

/* Text sits tight below image — no gap */
.hero-text{
  padding:16px 22px 28px;
  max-width:560px;
}
.hero-tag{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--bl);color:var(--ma);
  font-size:11px;font-weight:600;
  letter-spacing:.05em;text-transform:uppercase;
  padding:5px 12px;border-radius:20px;
  margin-bottom:14px;
}
.hero-tag span{opacity:.6}
h1.hero-h{
  font-family:'Fraunces',serif;
  font-size:clamp(28px,7vw,40px);
  font-weight:600;line-height:1.08;
  letter-spacing:-.02em;
  color:var(--tx);
  margin-bottom:10px;
}
h1.hero-h em{font-style:italic;font-weight:400;color:var(--ma)}
.hero-sub{
  font-size:14.5px;color:var(--mu);
  line-height:1.55;margin-bottom:22px;
  max-width:440px;
}
.hero-sub b{color:var(--tx);font-weight:600}

.btn-main{
  display:block;width:100%;
  padding:17px 20px;
  background:var(--ma);color:var(--iv);
  font-size:15px;font-weight:600;
  border-radius:10px;text-align:center;
  box-shadow:0 4px 14px rgba(122,30,60,.22);
  transition:background .15s;
  max-width:480px;
  -webkit-appearance:none;
}
.btn-main:active{background:var(--ma2)}
.hero-meta{
  display:flex;flex-wrap:wrap;gap:12px;
  margin-top:14px;
  font-size:12px;color:var(--mu);font-weight:500;
}
.hero-meta span{display:flex;align-items:center;gap:4px}

/* Desktop: side-by-side */
@media(min-width:700px){
  .hero{display:grid;grid-template-columns:1fr 1fr;min-height:calc(100svh - 54px)}
  .hero-img-wrap{height:100%;max-height:none;order:2}
  .hero-img-wrap::after{
    background:linear-gradient(to right, var(--iv), transparent);
    width:120px;height:100%;top:0;left:0;right:auto;bottom:auto;
  }
  .hero-text{
    display:flex;flex-direction:column;justify-content:center;
    padding:48px 40px 48px 48px;order:1;
  }
  .btn-main{max-width:360px}
}

/* ── STEPS ── */
.steps-sec{
  padding:28px 20px;
  background:var(--wh);
  border-top:1px solid var(--bd);
}
.steps-sec-inner{max-width:900px;margin:0 auto}
.steps-label{
  font-family:'Fraunces',serif;font-style:italic;
  font-size:13px;color:var(--ma);text-align:center;
  margin-bottom:18px;letter-spacing:.02em;
}
.steps-row{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:0;
}
.step{
  display:flex;flex-direction:column;align-items:center;
  text-align:center;padding:0 12px;
  position:relative;
}
.step:not(:last-child)::after{
  content:'';
  position:absolute;top:18px;right:0;
  width:1px;height:36px;
  background:var(--bd);
}
.step-ic{font-size:22px;margin-bottom:6px}
.step h3{font-family:'Fraunces',serif;font-size:13px;font-weight:600;color:var(--tx);margin-bottom:3px}
.step p{font-size:11.5px;color:var(--mu);line-height:1.45}

/* ── RELATE ── */
.relate{padding:28px 20px;background:var(--iv)}
.relate-inner{max-width:900px;margin:0 auto}
.sec-title{
  font-family:'Fraunces',serif;font-size:18px;font-weight:500;
  text-align:center;margin-bottom:4px;color:var(--tx);line-height:1.2;
}
.sec-title em{color:var(--ma);font-style:italic}
.sec-sub{text-align:center;font-size:12.5px;color:var(--mu);margin-bottom:18px}
.syms{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
@media(min-width:520px){.syms{grid-template-columns:repeat(3,1fr)}}
.sym{
  display:flex;align-items:center;gap:8px;
  padding:10px 12px;
  background:var(--wh);border:1px solid var(--bd);border-radius:10px;
  font-size:12.5px;font-weight:500;color:var(--tx);
}
.sym-ic{
  width:32px;height:32px;flex-shrink:0;border-radius:7px;
  background:var(--bl);display:flex;align-items:center;justify-content:center;font-size:16px;
}

/* ── PRIVACY ── */
.priv{
  padding:24px 20px;
  background:var(--ma2);color:var(--iv);
  display:flex;flex-direction:column;align-items:center;
  text-align:center;gap:12px;
}
.priv-inner{max-width:560px}
.priv h3{font-family:'Fraunces',serif;font-size:17px;font-weight:500;line-height:1.2;margin-bottom:4px}
.priv p{font-size:12.5px;opacity:.8;line-height:1.5}
.priv-tags{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:4px}
.priv-tag{font-size:11px;padding:5px 12px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:16px;font-weight:500}

/* ── BOTTOM CTA ── */
.btm{padding:24px 20px calc(28px + var(--sb));text-align:center;background:var(--iv)}
.btm p{font-family:'Fraunces',serif;font-style:italic;font-size:13.5px;color:var(--mu);margin-bottom:14px}
.btm .btn-main{margin:0 auto;max-width:480px}

/* ── QUIZ ── */
.q-wrap{padding-bottom:calc(60px + var(--sb))}
.q-top{
  padding:11px 20px;
  display:flex;justify-content:space-between;align-items:center;
  border-bottom:1px solid var(--bd);background:var(--iv);
  position:sticky;top:54px;z-index:20;
}
.q-back{font-size:13px;color:var(--mu);font-weight:500;padding:6px 0;min-width:44px}
.q-back:disabled{opacity:.3}
.q-lbl{font-family:'Fraunces',serif;font-style:italic;font-size:13px;color:var(--mu)}
.q-prog{height:3px;background:var(--bd);position:sticky;top:calc(54px + 44px);z-index:19}
.q-fill{height:100%;background:var(--ma);width:0%;transition:width .4s ease}
.q-body{padding:26px 22px 20px;max-width:540px;margin:0 auto}

.ques{animation:fadeUp .32s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.q-title{font-family:'Fraunces',serif;font-size:clamp(20px,5vw,26px);font-weight:500;line-height:1.2;margin-bottom:5px;color:var(--tx)}
.q-title em{color:var(--ma);font-style:italic;font-weight:400}
.q-hint{font-size:12.5px;color:var(--mu);margin-bottom:22px;font-family:'Fraunces',serif;font-style:italic}
.opts{display:flex;flex-direction:column;gap:9px}
.opt{
  padding:15px 16px;border:1.5px solid var(--bd);background:var(--wh);
  border-radius:10px;text-align:left;transition:all .15s;
  display:flex;align-items:center;gap:11px;
  font-size:14px;font-weight:500;color:var(--tx);-webkit-appearance:none;
}
.opt:active,.opt:hover{border-color:var(--ma);background:var(--bl)}
.opt-ic{width:36px;height:36px;flex-shrink:0;border-radius:7px;background:var(--iv2);display:flex;align-items:center;justify-content:center;font-size:19px}
.opt:active .opt-ic{background:rgba(232,180,188,.5)}

/* Insight */
.ins{animation:fadeUp .4s ease;text-align:center;padding:8px 0}
.ins-mark{display:inline-block;background:var(--bl);color:var(--go);font-size:11px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;padding:5px 12px;border-radius:16px;margin-bottom:18px}
.ins-body{font-family:'Fraunces',serif;font-size:clamp(19px,5vw,24px);font-weight:400;line-height:1.35;color:var(--tx);margin:0 auto 8px;max-width:480px}
.ins-body strong{color:var(--ma);font-weight:600}
.ins-attr{font-size:12px;color:var(--mu);margin-bottom:28px;font-family:'Fraunces',serif;font-style:italic}
.btn-sm{display:inline-block;padding:14px 30px;background:var(--ma);color:var(--iv);border-radius:8px;font-size:14px;font-weight:600}
.btn-sm:active{background:var(--ma2)}

/* Pattern */
.pat{animation:fadeUp .4s ease;text-align:center;padding:4px 0}
.pat h3{font-family:'Fraunces',serif;font-size:19px;font-weight:500;margin-bottom:22px;line-height:1.2;color:var(--tx)}
.pat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:320px;margin:0 auto 22px}
.pat-ring{width:48px;height:48px;margin:0 auto 5px;border-radius:50%;border:2.5px solid var(--ma);display:flex;align-items:center;justify-content:center;font-size:18px;animation:pulse 1.6s ease infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.pat-grid>div:nth-child(2) .pat-ring{border-color:var(--go);animation-delay:.2s}
.pat-grid>div:nth-child(3) .pat-ring{border-color:var(--ro);animation-delay:.4s}
.pat-grid>div:nth-child(4) .pat-ring{border-color:var(--go);animation-delay:.6s}
.pat-nm{font-size:10px;color:var(--mu);font-weight:600}
.pat-sub{font-family:'Fraunces',serif;font-style:italic;font-size:13.5px;color:var(--mu);margin-bottom:26px}

/* ── RESULT ── */
.r-top{
  padding:28px 22px 22px;
  background:linear-gradient(150deg,var(--ma2) 0%,var(--ma) 100%);
  color:var(--iv);text-align:center;
}
.r-eye{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;opacity:.65;margin-bottom:6px}
.r-pre{font-family:'Fraunces',serif;font-style:italic;font-size:15px;opacity:.8;margin-bottom:3px}
.r-type{font-family:'Fraunces',serif;font-size:clamp(34px,9vw,50px);font-weight:600;line-height:1.05;letter-spacing:-.02em;margin-bottom:12px}
.r-type::after{content:'';display:block;width:44px;height:2px;background:var(--go);margin:10px auto 0}
.r-sum{font-family:'Fraunces',serif;font-style:italic;font-size:14.5px;line-height:1.5;opacity:.9;max-width:480px;margin:0 auto}

.r-body{padding:16px 18px 0;max-width:700px;margin:0 auto}
.r-card{background:var(--wh);border:1px solid var(--bd);border-radius:12px;padding:18px;margin-bottom:14px}
.r-card h4{font-family:'Fraunces',serif;font-size:16px;font-weight:600;color:var(--ma2);margin-bottom:3px}
.r-card .sub{font-family:'Fraunces',serif;font-style:italic;font-size:12px;color:var(--mu);margin-bottom:14px}
.sig-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
@media(min-width:440px){.sig-grid{grid-template-columns:repeat(4,1fr)}}
.sig{text-align:center;padding:12px 6px;background:var(--iv);border-radius:8px}
.sig-ic{font-size:20px;margin-bottom:5px}
.sig b{display:block;font-size:11px;color:var(--tx);line-height:1.3}

.meaning{background:var(--bl);border-radius:12px;padding:16px 18px;margin-bottom:14px}
.meaning h4{font-family:'Fraunces',serif;font-size:15px;font-weight:600;color:var(--ma2);margin-bottom:5px}
.meaning p{font-size:13px;color:var(--tx);margin-bottom:6px;line-height:1.55}
.meaning .good{font-family:'Fraunces',serif;font-style:italic;color:var(--ma);font-size:13px}

.ing-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}
@media(min-width:440px){.ing-grid{grid-template-columns:repeat(4,1fr)}}
.ing{text-align:center;padding:12px 6px;background:var(--iv);border:1px solid var(--bd);border-radius:8px}
.ing-ic{font-size:19px;margin-bottom:5px}
.ing b{font-family:'Fraunces',serif;font-size:12.5px;display:block;margin-bottom:2px}
.ing span{font-size:10px;color:var(--mu);display:block;line-height:1.35}

.prod{display:flex;gap:14px;align-items:center;background:var(--iv2);border:1px solid var(--bd);border-radius:12px;padding:14px;margin-bottom:14px}
@media(max-width:380px){.prod{flex-direction:column;text-align:center}}
.prod-img-box{width:80px;height:80px;flex-shrink:0;border-radius:8px;overflow:hidden;background:var(--wh)}
.prod-img-box img{width:100%;height:100%;object-fit:cover}
.prod-name{font-family:'Fraunces',serif;font-size:14px;font-weight:600;color:var(--ma2);margin-bottom:3px}
.prod-desc{font-size:12px;color:var(--tx);line-height:1.5;margin-bottom:7px}
.prod-tags{display:flex;flex-wrap:wrap;gap:5px}
.prod-tag{font-size:9.5px;padding:3px 7px;background:var(--wh);border-radius:10px;color:var(--mu);font-weight:500;border:1px solid var(--bd)}

.r-cta{background:var(--ma2);border-radius:12px;padding:22px 18px;margin-bottom:14px;text-align:center;color:var(--iv)}
.r-cta h3{font-family:'Fraunces',serif;font-size:18px;font-weight:500;margin-bottom:7px;line-height:1.2}
.r-cta p{font-size:13px;opacity:.85;margin-bottom:18px;line-height:1.5}
.r-cta-feats{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:18px}
.r-cta-feat{font-size:11px;opacity:.9;display:flex;align-items:center;gap:4px}
.btn-solid{display:block;padding:15px;background:var(--iv);color:var(--ma2);border-radius:8px;font-weight:700;font-size:14.5px;-webkit-appearance:none}
.btn-solid:active{background:var(--bl)}
.order-link{display:block;margin:12px auto 0;font-size:12px;color:var(--ro);text-decoration:underline;opacity:.8}
.guar{font-family:'Fraunces',serif;font-style:italic;font-size:11.5px;color:var(--ro);margin-top:12px}

.trust-strip{padding:16px 18px;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;border-top:1px solid var(--bd)}
.t-badge{font-size:10.5px;padding:5px 10px;border:1px solid var(--bd);border-radius:4px;background:var(--wh);font-weight:600;color:var(--ma)}

.r-footer{background:var(--ma2);color:var(--iv);padding:18px 20px calc(16px + var(--sb));text-align:center;font-size:11px;line-height:1.55}
.r-footer .brand{font-family:'Fraunces',serif;font-size:15px;font-weight:600;color:var(--wh);margin-bottom:4px}
.r-footer a{color:var(--ro)}
.r-footer-legal{opacity:.45;font-size:9.5px;margin-top:8px;line-height:1.5}

/* ── MODAL ── */
.m-bg{position:fixed;inset:0;background:rgba(42,21,24,.6);z-index:200;display:none;align-items:flex-end;justify-content:center;backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px)}
.m-bg.open{display:flex}
@media(min-width:680px){.m-bg{align-items:center;padding:20px}}
.m-box{background:var(--iv);width:100%;max-width:440px;max-height:92svh;overflow-y:auto;border-radius:20px 20px 0 0;padding:26px 20px calc(26px + var(--sb));position:relative;animation:slideUp .28s ease}
@media(min-width:680px){.m-box{border-radius:14px;padding:34px 28px}}
@keyframes slideUp{from{transform:translateY(18px);opacity:0}to{transform:none;opacity:1}}
.m-close{position:absolute;top:12px;right:12px;width:32px;height:32px;border-radius:50%;background:var(--iv2);font-size:19px;display:flex;align-items:center;justify-content:center;color:var(--tx)}
.m-eye{font-family:'Fraunces',serif;font-style:italic;font-size:12.5px;color:var(--ma);margin-bottom:3px}
.m-box h2{font-family:'Fraunces',serif;font-size:21px;font-weight:600;color:var(--ma2);margin-bottom:5px;line-height:1.2}
.m-sub{font-size:13px;color:var(--mu);margin-bottom:12px;line-height:1.5}
.m-ctx{background:var(--bl);padding:8px 12px;border-radius:7px;font-size:11.5px;color:var(--ma2);margin-bottom:10px}
.m-assure{font-size:11.5px;color:var(--mu);padding:7px 12px;background:var(--iv2);border-radius:7px;margin-bottom:16px;display:flex;align-items:flex-start;gap:6px;line-height:1.5}
.m-assure::before{content:'👩';flex-shrink:0}
.fld{margin-bottom:11px}
.fld label{display:block;font-size:12px;font-weight:600;margin-bottom:4px}
.fld input,.fld select{width:100%;padding:13px 13px;border:1.5px solid var(--bd);border-radius:8px;font-family:inherit;font-size:15px;color:var(--tx);background:var(--wh);-webkit-appearance:none}
.fld input:focus,.fld select:focus{outline:none;border-color:var(--ma);box-shadow:0 0 0 3px rgba(122,30,60,.1)}
.m-tgl{display:flex;align-items:center;gap:7px;padding:9px 11px;background:var(--wh);border:1px solid var(--bd);border-radius:7px;margin:3px 0 14px;font-size:12.5px;cursor:pointer}
.m-tgl input{accent-color:var(--ma);width:15px;height:15px;margin:0}
.m-btn{width:100%;padding:14px;background:var(--ma);color:var(--iv);font-size:14.5px;font-weight:600;border-radius:8px;margin-top:3px;-webkit-appearance:none}
.m-btn:active{background:var(--ma2)}
.m-btn:disabled{opacity:.6}
.m-fine{font-size:10.5px;color:var(--mu);text-align:center;margin-top:9px;line-height:1.5}
.m-suc{display:none;text-align:center;padding:10px 0}.m-suc.show{display:block}
.m-suc svg{margin:0 auto 12px}
.m-suc h3{font-family:'Fraunces',serif;font-size:20px;color:var(--ma2);margin-bottom:7px;font-weight:600}
.m-suc p{font-size:13px;line-height:1.5;margin-bottom:4px}
.m-suc b{color:var(--ma)}
</style>
</head>
<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P9TM6ZQN" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<!-- HEADER -->
<header>
  <div class="hdr">
    <div class="logo">Cuehealth<span>Cycle Care · Est. 2025</span></div>
    <a class="hdr-wa" href="https://wa.me/917455918832">
      <span class="wa-dot"></span><b>7455918832</b>
    </a>
  </div>
</header>

