function calculateType() {
  const a = state.answers;

  // Score each dimension (higher = stronger indicator)
  const cramps = typeof a.q3 === 'number' ? a.q3 : 0;
  const cycle = typeof a.q2 === 'number' ? a.q2 : 0;
  const mood = typeof a.q4 === 'number' ? a.q4 : 0;
  const flow = typeof a.q5 === 'number' ? a.q5 : 0;

  // Primary focus from Q8 gets extra weight
  const focusBoost = { cramps: 1.5, cycle: 1.5, mood: 1.5, flow: 1.5 };
  const focusMap = { cramps: 'warrior', cycle: 'waverider', mood: 'storm', flow: 'whisper' };

  const scores = {
    warrior: cramps * 1.2 + (a.q8 === 'cramps' ? 3 : 0),
    waverider: cycle * 1.2 + (a.q8 === 'cycle' ? 3 : 0),
    storm: mood * 1.2 + (a.q8 === 'mood' ? 3 : 0),
    whisper: flow * 1.2 + (a.q8 === 'flow' ? 3 : 0)
  };

  // find highest
  let topType = 'warrior';
  let topScore = -1;
  for (const [type, score] of Object.entries(scores)) {
    if (score > topScore) {
      topScore = score;
      topType = type;
    }
  }
  return topType;
}

function showResult() {
  const typeKey = calculateType();
  const type = types[typeKey];

  document.getElementById('resultTypeName').textContent = type.name;
  document.getElementById('resultSummary').textContent = type.summary;
  document.getElementById('modalResultName').textContent = type.name;

  // body map
  document.getElementById('bodyMap').innerHTML = type.bodyMap.map(item => `
    <div class="body-map-item">
      <b>${item.title}</b>
      <span>${item.desc}</span>
    </div>
  `).join('');

  // ingredients
  document.getElementById('ingredientsFor').innerHTML = type.ingredients.map(ing => `
    <div class="ingredient-tile">
      <b>${ing.name} <span>${ing.dose}</span></b>
      <p>${ing.note}</p>
    </div>
  `).join('');

  showView('viewResult');
}

