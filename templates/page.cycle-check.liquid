  else{const oh=s.opts.map((o,i)=>`<button class="opt" onclick="pick('${s.id}',${JSON.stringify(o.v).replace(/"/g,'&quot;')})"><div class="opt-ic">${s.ic[i]}</div><div class="opt-tx">${o.l}</div></button>`).join('');c.innerHTML=`<div class="ques"><h2 class="q-title">${s.title}</h2><p class="q-hint">${s.hint}</p><div class="opts">${oh}</div></div>`}
