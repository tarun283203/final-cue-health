  storm:{name:'The Storm 🌪',sum:'Tumhara body physical se pehle emotional signals deta hai. PMS ki intensity hormonal shifts se aati hai.',sigs:[{ic:'🌀',l:'Strong PMS'},{ic:'😤',l:'Emotional Peaks'},{ic:'🧠',l:'Stress High'},{ic:'💛',l:'Needs Calm'}],meaning:'Mood swings hormones ke cycle ka part hain — par itni intensity zaroori nahi. Adaptogens ise balance karte hain.',ings:[{ic:'🌾',n:'Ashwagandha',d:'Mood adaptogen'},{ic:'🌸',n:'Jatamansi',d:'Mind calm'},{ic:'🍯',n:'Yashtimadhu',d:'Nervous support'},{ic:'🌿',n:'Bhringraj',d:'Rejuvenator'}]},
  whisper:{name:'The Whisper 🤫',sum:'Tumhara body silently bahut kaam kar raha hai. Heavy flow aur thakaan — extra inner strength ki zarurat hai.',sigs:[{ic:'💧',l:'Heavy Flow'},{ic:'😴',l:'Deep Fatigue'},{ic:'🤫',l:'Silent Struggle'},{ic:'💪',l:'Needs Strength'}],meaning:'Heavy flow se body ke reserves affect hote hain. Deep nourishment aur strengthening dono zaroori hain.',ings:[{ic:'🌿',n:'Ashoka',d:'Flow support'},{ic:'🌾',n:'Lodhra',d:'Women\'s herb'},{ic:'🌱',n:'Shatavari',d:'Nourishment'},{ic:'🌾',n:'Ashwagandha',d:'Strength'}]}
