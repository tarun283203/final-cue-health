<script>
// Earnings Calculator
function updateCalc(val){
  const v=parseInt(val);
  const earn=v*200;
  document.getElementById('slider-val').textContent=v;
  document.getElementById('daily-earn').textContent='₹'+earn.toLocaleString('en-IN');
  document.getElementById('weekly-earn').textContent='₹'+(earn*7).toLocaleString('en-IN');
  document.getElementById('monthly-earn').textContent='₹'+(earn*30).toLocaleString('en-IN');
  // update slider gradient
  const slider=document.getElementById('earnSlider');
  const pct=(v-1)/(30-1)*100;
  slider.style.background=`linear-gradient(to right,var(--green) 0%,var(--green) ${pct}%,#E5E7EB ${pct}%,#E5E7EB 100%)`;
}

// FAQ toggle
function toggleFaq(btn){
  const item=btn.closest('.faq-item');
  const wasOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
  if(!wasOpen) item.classList.add('open');
}

// Form submit
var PARTNER_WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbwXKU5k9mL5r2LIyiVLi4fzJJ5DLlJ_hNodD1AvqV5EiOwTTbMXm92HDe5vFix3XNJq/exec';

function submitForm(e){
  e.preventDefault();
  var form = document.getElementById('partnerForm');
  var btn = form.querySelector('.form-submit');
  var sellMethods = Array.prototype.slice.call(form.querySelectorAll('input[name="sell"]:checked')).map(function(cb){ return cb.value; }).join(', ');

  var data = new URLSearchParams({
    name: form.name.value,
    whatsapp: form.whatsapp.value,
    city: form.city.value,
    occupation: form.occupation.value,
    sellMethods: sellMethods,
    earningGoal: form.earningGoal.value,
    whyPartner: form.whyPartner.value,
    pageUrl: window.location.href
  });

  btn.disabled = true;
  btn.textContent = 'भेजा जा रहा है...';

  fetch(PARTNER_WEBHOOK_URL, {
    method: 'POST',
    mode: 'no-cors',
    body: data
  }).catch(function(){}).finally(function(){
    form.style.display='none';
    document.getElementById('successMsg').style.display='block';
    window.scrollTo({top:document.getElementById('successMsg').getBoundingClientRect().top+window.scrollY-80,behavior:'smooth'});
  });
}

// Countdown seats (demo)
let seats=47;
setInterval(()=>{
  if(seats>38 && Math.random()>0.85){
    seats--;
    document.getElementById('seats').textContent=seats;
  }
},8000);

// Init calculator
updateCalc(5);
</script>
