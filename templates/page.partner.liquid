<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="CueHealth Partner बनें और हर sale पर ₹200-300 कमाएं। कोई investment नहीं, कोई joining fee नहीं। Ayurvedic wellness products, Zoom training और ready scripts के साथ।">
<title>CueHealth Partner Program — अपने शहर से कमाएं | ₹200-300 हर Sale पर</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700;800&family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --green:#1B4332;
  --green-light:#2D6A4F;
  --green-pale:#D8F3DC;
  --green-bg:#F0FFF4;
  --gold:#C8860A;
  --gold-light:#F5C842;
  --gold-bg:#FFFBEB;
  --saffron:#E8622A;
  --cream:#FDFCF7;
  --dark:#111111;
  --body:#374151;
  --muted:#6B7280;
  --border:#E5DDD0;
  --card:#FFFFFF;
  --shadow:0 2px 16px rgba(27,67,50,0.10);
  --shadow-lg:0 8px 40px rgba(27,67,50,0.16);
  --ease:cubic-bezier(.22,1,.36,1);
}
html{scroll-behavior:smooth}
body{font-family:'Noto Sans',sans-serif;background:var(--cream);color:var(--body);line-height:1.7;overflow-x:hidden}
.hindi{font-family:'Noto Sans Devanagari','Baloo 2',sans-serif}
h1,h2,h3,.display{font-family:'Baloo 2',sans-serif;line-height:1.2}

/* ===== ICONS ===== */
.icon{width:1em;height:1em;display:inline-block;vertical-align:-0.15em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.icon-fill{fill:currentColor;stroke:none}
.icon-lg{width:2.75rem;height:2.75rem;stroke-width:1.5}
.icon-avatar{width:1.3rem;height:1.3rem}

/* ===== SCROLL PROGRESS + REVEAL ===== */
.scroll-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--gold),var(--gold-light));z-index:300;width:0%;transition:width .1s linear}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-stagger.visible .reveal-child{transition-delay:calc(var(--i,0) * 90ms)}

/* ===== NAV ===== */
.nav{position:sticky;top:0;z-index:200;background:rgba(27,67,50,0.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);padding:0 5%;display:flex;align-items:center;justify-content:space-between;height:60px;box-shadow:0 2px 12px rgba(0,0,0,0.15);transition:box-shadow .3s var(--ease),background .3s var(--ease)}
.nav.scrolled{box-shadow:0 6px 24px rgba(0,0,0,0.25);background:rgba(13,43,29,0.96)}
.nav-logo{color:#fff;font-family:'Baloo 2',sans-serif;font-size:1.2rem;font-weight:800;display:flex;align-items:center;gap:8px;text-decoration:none}
.nav-logo span{background:var(--gold);color:#fff;border-radius:6px;padding:2px 8px;font-size:.85rem}
.nav-cta{background:var(--gold);color:#fff;border:none;padding:8px 20px;border-radius:24px;font-weight:700;cursor:pointer;font-family:'Baloo 2',sans-serif;font-size:.9rem;text-decoration:none;transition:.25s var(--ease);position:relative}
.nav-cta:hover{background:var(--gold-light);color:var(--dark);transform:translateY(-2px);box-shadow:0 6px 16px rgba(200,134,10,0.4)}

/* ===== HERO ===== */
.hero{background:linear-gradient(135deg,#0D2B1D 0%,#1B4332 45%,#2D6A4F 100%);min-height:92vh;display:flex;align-items:center;justify-content:center;padding:4rem 5%;position:relative;overflow:hidden;text-align:center}
.hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M40 40c0-11 9-20 20-20s20 9 20 20-9 20-20 20-20-9-20-20zm-40 0c0-11 9-20 20-20s20 9 20 20-9 20-20 20S0 51 0 40z'/%3E%3C/g%3E%3C/svg%3E");pointer-events:none}
.hero-blob{position:absolute;border-radius:50%;filter:blur(60px);pointer-events:none;opacity:.35;animation:float 12s ease-in-out infinite}
.hero-blob.b1{width:340px;height:340px;background:radial-gradient(circle,var(--gold) 0%,transparent 70%);top:-80px;right:-60px;animation-delay:0s}
.hero-blob.b2{width:280px;height:280px;background:radial-gradient(circle,#2D6A4F 0%,transparent 70%);bottom:-60px;left:-40px;animation-delay:-4s}
.hero-blob.b3{width:200px;height:200px;background:radial-gradient(circle,var(--gold-light) 0%,transparent 70%);top:40%;left:8%;animation-delay:-8s}
@keyframes float{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(20px,-24px) scale(1.08)}}
.hero-inner{max-width:800px;position:relative;z-index:1}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(200,134,10,0.2);border:1px solid rgba(200,134,10,0.4);padding:6px 18px;border-radius:24px;color:var(--gold-light);font-size:.82rem;font-weight:600;margin-bottom:1.5rem;font-family:'Baloo 2',sans-serif;animation:fadeDown .8s var(--ease) both}
.hero-badge .dot{width:6px;height:6px;border-radius:50%;background:var(--gold-light);display:inline-block;animation:pulseDot 1.8s ease-in-out infinite}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.6)}}
@keyframes fadeDown{from{opacity:0;transform:translateY(-14px)}to{opacity:1;transform:translateY(0)}}
.hero h1{font-size:clamp(2rem,5vw,3.5rem);font-weight:800;color:#fff;margin-bottom:1rem;line-height:1.15;animation:fadeUp .8s var(--ease) .1s both}
.hero h1 .gold{color:var(--gold-light)}
.hero h1 .big{font-size:clamp(2.5rem,6vw,4.2rem);display:block}
.hero-sub{font-size:clamp(.95rem,2vw,1.15rem);color:rgba(255,255,255,0.8);max-width:600px;margin:0 auto 2rem;font-family:'Noto Sans Devanagari',sans-serif;line-height:1.8;animation:fadeUp .8s var(--ease) .2s both}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
.hero-numbers{display:flex;gap:1.5rem;justify-content:center;margin-bottom:2.5rem;flex-wrap:wrap;animation:fadeUp .8s var(--ease) .3s both}
.hero-num{text-align:center;transition:transform .3s var(--ease)}
.hero-num:hover{transform:translateY(-3px)}
.hero-num .n{font-family:'Baloo 2',sans-serif;font-size:2.2rem;font-weight:800;color:var(--gold-light);line-height:1}
.hero-num .l{font-size:.75rem;color:rgba(255,255,255,0.65);margin-top:2px}
.hero-divider{width:1px;background:rgba(255,255,255,0.15);align-self:stretch}
.hero-btn{display:inline-block;background:linear-gradient(135deg,var(--gold),#E8A020);color:#fff;padding:16px 40px;border-radius:50px;font-family:'Baloo 2',sans-serif;font-size:1.15rem;font-weight:800;text-decoration:none;box-shadow:0 6px 30px rgba(200,134,10,0.4);transition:transform .3s var(--ease),box-shadow .3s var(--ease);border:none;cursor:pointer;position:relative;overflow:hidden;animation:fadeUp .8s var(--ease) .4s both}
.hero-btn::after{content:'';position:absolute;top:0;left:-75%;width:50%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,0.45),transparent);transform:skewX(-20deg);animation:shine 3.2s ease-in-out infinite}
@keyframes shine{0%{left:-75%}50%,100%{left:130%}}
.hero-btn:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 12px 40px rgba(200,134,10,0.55)}
.hero-note{margin-top:1rem;color:rgba(255,255,255,0.5);font-size:.8rem;animation:fadeUp .8s var(--ease) .5s both}
.scroll-hint{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);color:rgba(255,255,255,0.4);font-size:.75rem;display:flex;flex-direction:column;align-items:center;gap:6px;animation:bounce 2s infinite}
@keyframes bounce{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(6px)}}

/* hero stats layout */
.hero-numbers{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:1.25rem;align-items:center;max-width:820px;margin-left:auto;margin-right:auto}
@media(max-width:700px){.hero-numbers{grid-template-columns:1fr 1fr;gap:1.25rem 1rem}.hero-divider{display:none}}

/* ===== SECTION BASE ===== */
.section{padding:5rem 5%}
.section-inner{max-width:1100px;margin:0 auto}
.section-eyebrow{font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:.75rem;font-family:'Baloo 2',sans-serif}
.section-title{font-size:clamp(1.6rem,3.5vw,2.4rem);font-weight:800;color:var(--dark);margin-bottom:.5rem}
.section-sub{color:var(--muted);font-size:1rem;max-width:600px;margin-bottom:2.5rem}

/* ===== CALCULATOR ===== */
.calc-section{background:var(--green);padding:5rem 5%}
.calc-inner{max-width:850px;margin:0 auto;text-align:center}
.calc-title{color:#fff;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;margin-bottom:.5rem}
.calc-sub{color:rgba(255,255,255,0.7);margin-bottom:3rem;font-family:'Noto Sans Devanagari',sans-serif;font-size:1rem}
.calc-box{background:#fff;border-radius:20px;padding:2.5rem;box-shadow:var(--shadow-lg)}
.calc-label{font-size:1rem;font-weight:600;color:var(--body);margin-bottom:.75rem;font-family:'Noto Sans Devanagari',sans-serif}
.calc-label span{color:var(--green);font-weight:800}
.slider-wrap{position:relative;margin-bottom:2rem}
.calc-slider{width:100%;-webkit-appearance:none;height:8px;border-radius:8px;background:linear-gradient(to right,var(--green) 0%,var(--green) 50%,#E5E7EB 50%,#E5E7EB 100%);outline:none;cursor:pointer}
.calc-slider::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;border-radius:50%;background:var(--green);cursor:pointer;box-shadow:0 2px 8px rgba(27,67,50,0.4);transition:transform .2s var(--ease),box-shadow .2s var(--ease)}
.calc-slider:hover::-webkit-slider-thumb,.calc-slider:active::-webkit-slider-thumb{transform:scale(1.15);box-shadow:0 4px 16px rgba(27,67,50,0.5)}
.result-num{transition:color .2s}
.calc-box{transition:box-shadow .3s var(--ease)}
.slider-marks{display:flex;justify-content:space-between;margin-top:6px;font-size:.7rem;color:var(--muted)}
.calc-result{background:linear-gradient(135deg,var(--green-bg),#fff);border:2px solid var(--green-pale);border-radius:16px;padding:2rem;margin-top:1.5rem}
.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
.result-item{text-align:center;padding:1rem;border-radius:12px;background:#fff;border:1px solid var(--border)}
.result-num{font-family:'Baloo 2',sans-serif;font-size:1.8rem;font-weight:800;color:var(--green)}
.result-label{font-size:.75rem;color:var(--muted);margin-top:2px;font-family:'Noto Sans Devanagari',sans-serif}
.result-highlight{background:linear-gradient(135deg,var(--green),var(--green-light));color:#fff;border:none}
.result-highlight .result-num{color:#fff;font-size:2.2rem}
.result-highlight .result-label{color:rgba(255,255,255,0.8)}

/* ===== PRODUCTS ===== */
.products-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:2rem}
.product-card{background:var(--card);border:1px solid var(--border);border-radius:18px;overflow:hidden;transition:.25s;box-shadow:var(--shadow)}
.product-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.product-img{height:180px;display:flex;align-items:center;justify-content:center;font-size:5rem}
.product-img.shilajit{background:linear-gradient(135deg,#1B4332,#2D6A4F)}
.product-img.women{background:linear-gradient(135deg,#7C3AED,#9D5DE0)}
.product-img.young{background:linear-gradient(135deg,#D97706,#F59E0B)}
.product-body{padding:1.5rem}
.product-name{font-family:'Baloo 2',sans-serif;font-size:1.15rem;font-weight:700;color:var(--dark);margin-bottom:.25rem}
.product-hindi{font-family:'Noto Sans Devanagari',sans-serif;font-size:.82rem;color:var(--muted);margin-bottom:.75rem}
.product-benefit{font-size:.82rem;color:var(--body);margin-bottom:1rem;line-height:1.6}
.product-earn{background:var(--green-bg);border:1px solid var(--green-pale);border-radius:10px;padding:.75rem 1rem;display:flex;align-items:center;justify-content:space-between}
.earn-label{font-size:.75rem;color:var(--green);font-weight:600;font-family:'Noto Sans Devanagari',sans-serif}
.earn-amount{font-family:'Baloo 2',sans-serif;font-size:1.4rem;font-weight:800;color:var(--green)}
.product-price{font-size:.75rem;color:var(--muted);margin-top:.5rem;text-align:right}

/* ===== HOW IT WORKS ===== */
.how-section{background:var(--green-bg);padding:5rem 5%}
.steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;margin-top:2.5rem}
.step-card{background:#fff;border-radius:16px;padding:1.75rem;text-align:center;border:1px solid var(--border);position:relative;overflow:hidden;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.step-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.step-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--green),var(--gold))}
.step-num{width:48px;height:48px;background:linear-gradient(135deg,var(--green),var(--green-light));border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;font-family:'Baloo 2',sans-serif;font-size:1.3rem;font-weight:800;color:#fff;transition:transform .3s var(--ease)}
.step-card:hover .step-num{transform:scale(1.1) rotate(-6deg)}
.step-title{font-family:'Baloo 2',sans-serif;font-size:1rem;font-weight:700;color:var(--dark);margin-bottom:.25rem}
.step-hindi{font-family:'Noto Sans Devanagari',sans-serif;font-size:.82rem;color:var(--muted);margin-bottom:.5rem}
.step-desc{font-size:.82rem;color:var(--body);line-height:1.6}

/* ===== WHO IS THIS FOR ===== */
.qualify-section{padding:5rem 5%}
.qualify-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:2rem}
.qualify-card{border-radius:16px;padding:2rem;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
.qualify-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}
.qualify-yes{background:var(--green-bg);border:2px solid var(--green-pale)}
.qualify-no{background:#FEF2F2;border:2px solid #FECACA}
.qualify-card li{transition:transform .2s var(--ease)}
.qualify-card li:hover{transform:translateX(4px)}
.qualify-card h3{font-family:'Baloo 2',sans-serif;font-size:1.1rem;font-weight:700;margin-bottom:1rem;display:flex;align-items:center;gap:.5rem}
.qualify-card ul{list-style:none;display:flex;flex-direction:column;gap:.5rem}
.qualify-card li{font-size:.88rem;display:flex;align-items:flex-start;gap:.5rem;font-family:'Noto Sans Devanagari',sans-serif;line-height:1.5}

/* ===== TESTIMONIALS ===== */
.testi-section{background:linear-gradient(135deg,#1B4332 0%,#2D6A4F 100%);padding:5rem 5%}
.testi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:2.5rem}
.testi-card{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:16px;padding:1.75rem;transition:transform .3s var(--ease),background .3s var(--ease),border-color .3s var(--ease)}
.testi-card:hover{transform:translateY(-6px);background:rgba(255,255,255,0.13);border-color:rgba(245,200,66,0.4)}
.testi-quote{font-size:.92rem;color:rgba(255,255,255,0.85);margin-bottom:1rem;line-height:1.8;font-family:'Noto Sans Devanagari',sans-serif}
.testi-quote::before{content:'"';font-family:'Baloo 2',sans-serif;font-size:2rem;color:var(--gold-light);line-height:0;vertical-align:-0.4rem;margin-right:4px}
.testi-author{display:flex;align-items:center;gap:.75rem}
.testi-avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0}
.testi-name{font-family:'Baloo 2',sans-serif;font-size:.9rem;font-weight:700;color:#fff}
.testi-location{font-size:.72rem;color:rgba(255,255,255,0.55)}
.testi-earn{margin-top:.75rem;display:inline-block;background:rgba(200,134,10,0.2);border:1px solid rgba(200,134,10,0.3);padding:4px 12px;border-radius:20px;font-size:.75rem;color:var(--gold-light);font-weight:600}

/* ===== EARNINGS TABLE ===== */
.table-section{padding:5rem 5%;background:var(--gold-bg)}
.earnings-table{width:100%;border-collapse:separate;border-spacing:0;border-radius:16px;overflow:hidden;box-shadow:var(--shadow-lg);margin-top:2rem}
.earnings-table th{background:var(--green);color:#fff;padding:1rem 1.25rem;text-align:center;font-family:'Baloo 2',sans-serif;font-size:.88rem;font-weight:700}
.earnings-table td{padding:1rem 1.25rem;text-align:center;font-family:'Baloo 2',sans-serif;font-size:1rem;background:#fff;border-bottom:1px solid var(--border)}
.earnings-table tr:last-child td{border-bottom:none}
.earnings-table tr:nth-child(even) td{background:#F9F9F7}
.earnings-table .highlight-row td{background:linear-gradient(135deg,var(--green-bg),#fff);font-weight:700;color:var(--green);font-size:1.1rem}
.earnings-table .sales-col{font-weight:700;color:var(--dark)}
.earnings-table .money{color:var(--green);font-weight:800}

/* ===== APPLICATION FORM ===== */
.form-section{padding:5rem 5%}
.form-wrap{max-width:700px;margin:0 auto}
.form-card{background:#fff;border-radius:20px;padding:3rem;box-shadow:var(--shadow-lg);border:1px solid var(--border)}
.form-group{margin-bottom:1.5rem}
.form-label{display:block;font-size:.88rem;font-weight:600;color:var(--dark);margin-bottom:.5rem;font-family:'Noto Sans Devanagari',sans-serif}
.form-label span{color:var(--muted);font-size:.78rem;font-weight:400}
.form-input,.form-select,.form-textarea{width:100%;padding:.85rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-family:'Noto Sans Devanagari','Noto Sans',sans-serif;font-size:.92rem;color:var(--dark);background:#fff;transition:.2s;outline:none}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(27,67,50,0.08)}
.form-textarea{resize:vertical;min-height:100px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.radio-group{display:flex;flex-direction:column;gap:.5rem}
.radio-option{display:flex;align-items:center;gap:.6rem;cursor:pointer;padding:.6rem .75rem;border:1.5px solid var(--border);border-radius:8px;transition:.2s}
.radio-option:hover{border-color:var(--green);background:var(--green-bg)}
.radio-option input[type=radio]{accent-color:var(--green);width:16px;height:16px}
.radio-option label{font-size:.88rem;cursor:pointer;font-family:'Noto Sans Devanagari',sans-serif}
.form-submit{width:100%;background:linear-gradient(135deg,var(--green),var(--green-light));color:#fff;border:none;padding:1.1rem;border-radius:12px;font-family:'Baloo 2',sans-serif;font-size:1.1rem;font-weight:800;cursor:pointer;transition:transform .25s var(--ease),box-shadow .25s var(--ease),opacity .25s;margin-top:.5rem;position:relative;overflow:hidden;box-shadow:0 4px 20px rgba(27,67,50,0.25)}
.form-submit:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 8px 28px rgba(27,67,50,0.35)}
.form-submit:disabled{cursor:not-allowed;opacity:.85}
.form-submit:active:not(:disabled){transform:translateY(0) scale(.98)}
.form-disclaimer{text-align:center;font-size:.75rem;color:var(--muted);margin-top:.75rem;font-family:'Noto Sans Devanagari',sans-serif}

/* ===== WHATSAPP FLOAT ===== */
.wa-float{position:fixed;bottom:1.5rem;right:1.5rem;z-index:999;background:#25D366;color:#fff;border-radius:50%;width:60px;height:60px;display:flex;align-items:center;justify-content:center;text-decoration:none;box-shadow:0 4px 20px rgba(37,211,102,0.5);transition:.25s;font-size:1.6rem}
.wa-float:hover{transform:scale(1.1);box-shadow:0 6px 28px rgba(37,211,102,0.6)}

/* ===== FAQ ===== */
.faq-section{background:var(--green-bg);padding:5rem 5%}
.faq-list{max-width:750px;margin:2rem auto 0;display:flex;flex-direction:column;gap:.75rem}
.faq-item{background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden;transition:border-color .25s var(--ease),box-shadow .25s var(--ease)}
.faq-item:hover{border-color:var(--green-pale);box-shadow:var(--shadow)}
.faq-item.open{border-color:var(--green-pale);box-shadow:var(--shadow)}
.faq-q{width:100%;background:none;border:none;padding:1.1rem 1.25rem;text-align:left;font-family:'Baloo 2',sans-serif;font-size:.95rem;font-weight:700;color:var(--dark);cursor:pointer;display:flex;justify-content:space-between;align-items:center}
.faq-q:after{content:'＋';font-size:1.2rem;color:var(--green);transition:transform .3s var(--ease);flex-shrink:0;display:inline-block}
.faq-item.open .faq-q:after{transform:rotate(135deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s var(--ease)}
.faq-item.open .faq-a{max-height:300px}
.faq-a-inner{padding:.25rem 1.25rem 1.1rem;font-size:.88rem;color:var(--body);font-family:'Noto Sans Devanagari',sans-serif;line-height:1.7}

/* ===== FOOTER ===== */
.footer{background:var(--dark);color:rgba(255,255,255,0.6);padding:2.5rem 5%;text-align:center;font-size:.82rem}
.footer-logo{font-family:'Baloo 2',sans-serif;font-size:1.3rem;font-weight:800;color:#fff;margin-bottom:.5rem}
.footer-links{display:flex;gap:1.5rem;justify-content:center;margin-top:1rem;flex-wrap:wrap}
.footer-links a{color:rgba(255,255,255,0.5);text-decoration:none;font-size:.78rem}
.footer-links a:hover{color:#fff}

/* ===== URGENCY BANNER ===== */
.urgency{background:linear-gradient(90deg,var(--saffron),#D94F00);color:#fff;text-align:center;padding:.65rem 1rem;font-family:'Baloo 2',sans-serif;font-size:.88rem;font-weight:600}

/* ===== SUCCESS MSG ===== */
.success-msg{display:none;background:var(--green-bg);border:2px solid var(--green-pale);border-radius:12px;padding:2rem;text-align:center;margin-top:1rem}
.success-msg h3{font-family:'Baloo 2',sans-serif;color:var(--green);font-size:1.3rem;margin-bottom:.5rem}
.success-msg p{font-family:'Noto Sans Devanagari',sans-serif;font-size:.9rem;color:var(--body)}

/* ===== RESPONSIVE ===== */
@media(max-width:768px){
  .qualify-grid{grid-template-columns:1fr}
  .form-row{grid-template-columns:1fr}
  .result-grid{grid-template-columns:1fr}
  .hero-numbers{gap:1rem}
  .hero-num .n{font-size:1.6rem}
  .form-card{padding:1.75rem 1.25rem}
  .section{padding:3.5rem 5%}
  .calc-section,.how-section,.testi-section,.table-section,.faq-section{padding:3.5rem 5%}
  .nav-logo span{display:none}
  .earnings-table th,.earnings-table td{padding:.7rem .35rem;font-size:.82rem}
  .earnings-table th{font-size:.72rem}
  .earnings-table .highlight-row td{font-size:.95rem}
  .hero-blob{max-width:100vw}
  html,body{max-width:100%;overflow-x:hidden}
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:.01ms !important;animation-iteration-count:1 !important;transition-duration:.01ms !important;scroll-behavior:auto !important}
  .reveal{opacity:1;transform:none}
}
