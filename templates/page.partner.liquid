<!-- WHATSAPP FLOAT -->
<a href="https://wa.me/917455918832?text=Namaste! Main CueHealth Partner Program ke baare mein janna chahta/chahti hoon." class="wa-float" title="WhatsApp पर बात करें" data-gtm-cta="whatsapp_float"><svg class="icon" style="width:1.6rem;height:1.6rem"><use href="#i-message"/></svg></a>

<script>
// Earnings Calculator (avg ₹250 commission per sale across the 3 products)
function updateCalc(val){
  const v=parseInt(val);
  const earn=v*250;
  document.getElementById('slider-val').textContent=v;
  document.getElementById('daily-earn').textContent='₹'+earn.toLocaleString('en-IN');
  document.getElementById('weekly-earn').textContent='₹'+(earn*7).toLocaleString('en-IN');
  document.getElementById('monthly-earn').textContent='₹'+(earn*30).toLocaleString('en-IN');
  // update slider gradient
  const slider=document.getElementById('earnSlider');
  const pct=(v-1)/(30-1)*100;
  slider.style.background=`linear-gradient(to right,var(--green) 0%,var(--green) ${pct}%,#E5E7EB ${pct}%,#E5E7EB 100%)`;
}

// FAQ toggle
function toggleFaq(btn){
  const item=btn.closest('.faq-item');
  const wasOpen=item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i=>i.classList.remove('open'));
  if(!wasOpen) item.classList.add('open');
}

// Form submit
var PARTNER_WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbwXKU5k9mL5r2LIyiVLi4fzJJ5DLlJ_hNodD1AvqV5EiOwTTbMXm92HDe5vFix3XNJq/exec';

function submitForm(e){
  e.preventDefault();
  var form = document.getElementById('partnerForm');
  var btn = form.querySelector('.form-submit');
  var sellMethods = Array.prototype.slice.call(form.querySelectorAll('input[name="sell"]:checked')).map(function(cb){ return cb.value; }).join(', ');

  var data = new URLSearchParams({
    name: form.name.value,
    whatsapp: form.whatsapp.value,
    city: form.city.value,
    occupation: form.occupation.value,
    sellMethods: sellMethods,
    earningGoal: form.earningGoal.value,
    whyPartner: form.whyPartner.value,
    pageUrl: window.location.href
  });

  btn.disabled = true;
  btn.textContent = 'भेजा जा रहा है...';

  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    event: 'generate_lead',
    form_id: 'partner_application',
    city: form.city.value,
    occupation: form.occupation.value,
    earning_goal: form.earningGoal.value
  });

  fetch(PARTNER_WEBHOOK_URL, {
    method: 'POST',
    mode: 'no-cors',
    body: data
  }).catch(function(){}).finally(function(){
    form.style.display='none';
    document.getElementById('successMsg').style.display='block';
    window.scrollTo({top:document.getElementById('successMsg').getBoundingClientRect().top+window.scrollY-80,behavior:'smooth'});
  });
}

// GTM click tracking for CTAs (Apply buttons, WhatsApp float)
document.addEventListener('click', function(e){
  var el = e.target.closest('[data-gtm-cta]');
  if(!el) return;
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    event: 'cta_click',
    cta_id: el.getAttribute('data-gtm-cta'),
    cta_text: el.textContent.trim()
  });
});

// Init calculator
updateCalc(5);

// Scroll progress bar + nav scroll state
(function(){
  const bar=document.getElementById('scrollProgress');
  const nav=document.getElementById('mainNav');
  function onScroll(){
    const h=document.documentElement;
    const scrolled=(h.scrollTop)/(h.scrollHeight-h.clientHeight)*100;
    bar.style.width=scrolled+'%';
    nav.classList.toggle('scrolled', h.scrollTop>20);
  }
  document.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
})();

// Reveal-on-scroll for cards and section headers
(function(){
  const selectors=['.product-card','.step-card','.testi-card','.qualify-card','.faq-item','.calc-box','.form-card','.earnings-table','.section-eyebrow','.section-title','.section-sub'];
  const els=document.querySelectorAll(selectors.join(','));
  if(!('IntersectionObserver' in window)){ return; }
  const io=new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add('visible');
        io.unobserve(entry.target);
      }
    });
  }, {threshold:.15, rootMargin:'0px 0px -40px 0px'});
  els.forEach((el,i)=>{
    el.classList.add('reveal');
    el.style.transitionDelay=(i%4)*70+'ms';
    io.observe(el);
  });
})();

// Count-up animation for hero numbers
(function(){
  const nums=document.querySelectorAll('.hero-num .n');
  function animate(el){
    const raw=el.textContent.trim();
    const match=raw.match(/^([^\d]*)([\d,]+)(.*)$/);
    if(!match) return;
    const prefix=match[1], target=parseInt(match[2].replace(/,/g,''),10), suffix=match[3];
    if(!target){ return; }
    const dur=1100, start=performance.now();
    function step(now){
      const p=Math.min(1,(now-start)/dur);
      const eased=1-Math.pow(1-p,3);
      const val=Math.round(target*eased);
      el.textContent=prefix+val.toLocaleString('en-IN')+suffix;
      if(p<1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver((entries)=>{
      entries.forEach(entry=>{
        if(entry.isIntersecting){ animate(entry.target); io.unobserve(entry.target); }
      });
    }, {threshold:.6});
    nums.forEach(el=>io.observe(el));
  }
})();
</script>
</body>
</html>
